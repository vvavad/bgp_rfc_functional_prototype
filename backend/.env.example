# Copy this file to .env and fill in real values. .env is loaded automatically
# on every app startup (see app.py / ai_generation.py) -- no need to `export`
# anything in your shell. Never commit the real .env file.

# Required for AI-reasoned test generation (backend/ai_generation.py).
# Without this set, the app still runs fully -- it falls back to the
# heuristic template generator and the dashboard shows "Heuristic mode".
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Overrides the Claude model used for test generation.
# Defaults to claude-opus-4-8 if unset.
AI_MODEL=claude-opus-4-8
