# Copy this file to .env and fill in real values. .env is loaded automatically
# on every app startup (see app.py / ai_generation.py) -- no need to `export`
# anything in your shell. Never commit the real .env file.

# Which AI backend to use for test generation (backend/ai_generation.py):
#   auto       (default) -- prefer the local Claude Code CLI (see below), no
#               key needed; fall back to ANTHROPIC_API_KEY if the CLI isn't
#               found; fall back to heuristic templates if neither is.
#   cli        -- force the local Claude Code CLI only (heuristic if not found).
#   api        -- force the Anthropic API key only (heuristic if unset).
#   heuristic  -- disable AI entirely, always use heuristic templates.
AI_BACKEND=auto

# Only needed if you're running this OUTSIDE a Claude Code session (a plain
# terminal, CI, etc) -- inside Claude Code, AI_BACKEND=auto finds and uses
# the CLI's own existing login automatically, no key required. If set, this
# is used whenever the CLI backend isn't available (or AI_BACKEND=api).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional override if the CLI binary isn't in one of the locations
# ai_backends.py already checks (CLAUDE_CODE_EXECPATH env var, known VS
# Code/Cursor extension install paths, or `claude` on PATH).
# CLAUDE_CLI_PATH=/path/to/claude

# Optional. Overrides the Claude model used for test generation (works for
# both backends -- aliases like 'sonnet'/'opus' or a full model name).
# Defaults to claude-sonnet-5 if unset -- a good cost/quality balance for
# demos and bulk generation. Set to claude-opus-4-8 (or another top-tier
# model) for a real presentation where you want maximum reasoning quality
# and can afford the extra cost/time per call.
AI_MODEL=claude-sonnet-5

# Safety cap on POST /api/generate-all (pipeline.generate_all_gaps) -- an
# uncapped bulk-fill can trigger one real AI call per remaining gap
# (100+ on a freshly-ingested RFC), each a real, potentially paid Claude
# Code call. Set GENERATE_ALL_CAP_ENABLED=false to restore unlimited
# bulk-fill by default; either way, an explicit {"limit": N} in the request
# always overrides this, and {"limit": -1} explicitly bypasses the cap for
# one call regardless of these settings.
GENERATE_ALL_CAP_ENABLED=true
GENERATE_ALL_CAP_COUNT=20
